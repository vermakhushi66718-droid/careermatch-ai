generator client {
  provider   = "prisma-client-js"
  engineType = "client"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum JobType {
  FULL_TIME
  PART_TIME
  INTERNSHIP
  CONTRACT
}

enum WorkMode {
  ONSITE
  REMOTE
  HYBRID
}

enum ExperienceLevel {
  FRESHER
  JUNIOR
  MID
  SENIOR
}

enum ApplicationStatus {
  SAVED
  APPLIED
  INTERVIEWING
  OFFER
  REJECTED
  WITHDRAWN
}

enum InterviewStatus {
  IN_PROGRESS
  COMPLETED
}

enum ChatRole {
  USER
  ASSISTANT
}

model User {
  id                 String    @id @default(cuid())
  email              String    @unique
  passwordHash       String
  fullName           String
  role               Role      @default(USER)
  emailVerified      Boolean   @default(false)
  isActive           Boolean   @default(true)
  onboardingComplete Boolean   @default(false)
  createdAt          DateTime  @default(now())
  updatedAt          DateTime  @updatedAt
  lastLoginAt        DateTime?

  profile        Profile?
  refreshTokens  RefreshToken[]
  authTokens     AuthToken[]
  resumes        Resume[]
  applications   Application[]
  roadmaps       Roadmap[]
  interviews     InterviewSession[]
  chatMessages   ChatMessage[]
  savedJobs      SavedJob[]
}

model Profile {
  id               String   @id @default(cuid())
  userId           String   @unique
  user             User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  photoPath        String?
  phone            String?
  headline         String?
  summary          String?
  college          String?
  degree           String?
  fieldOfStudy     String?
  graduationYear   Int?
  cgpa             Float?
  technicalSkills  String[] @default([])
  softSkills       String[] @default([])
  certifications   Json     @default("[]")
  projects         Json     @default("[]")
  internships      Json     @default("[]")
  workExperience   Json     @default("[]")
  preferredRoles   String[] @default([])
  preferredLocations String[] @default([])
  expectedSalary   Int?
  careerInterests  String[] @default([])
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

model RefreshToken {
  id         String    @id @default(cuid())
  userId     String
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String    @unique
  expiresAt  DateTime
  revokedAt  DateTime?
  userAgent  String?
  createdAt  DateTime  @default(now())

  @@index([userId])
}

enum AuthTokenType {
  EMAIL_VERIFICATION
  PASSWORD_RESET
}

model AuthToken {
  id        String        @id @default(cuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      AuthTokenType
  tokenHash String        @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime      @default(now())

  @@index([userId, type])
}

model Resume {
  id            String   @id @default(cuid())
  userId        String
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  fileName      String
  filePath      String
  fileSize      Int
  rawText       String
  parsed        Json?
  analysis      Json?
  atsScore      Int?
  isPrimary     Boolean  @default(false)
  analysisError String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  improvements ResumeImprovement[]

  @@index([userId])
}

model ResumeImprovement {
  id         String   @id @default(cuid())
  resumeId   String
  resume     Resume   @relation(fields: [resumeId], references: [id], onDelete: Cascade)
  targetRole String?
  result     Json
  createdAt  DateTime @default(now())

  @@index([resumeId])
}

model Job {
  id              String          @id @default(cuid())
  title           String
  company         String
  location        String
  workMode        WorkMode        @default(ONSITE)
  type            JobType         @default(FULL_TIME)
  experienceLevel ExperienceLevel @default(FRESHER)
  description     String
  requiredSkills  String[]        @default([])
  preferredSkills String[]        @default([])
  minCgpa         Float?
  salaryMin       Int?
  salaryMax       Int?
  currency        String          @default("INR")
  applyUrl        String?
  category        String?
  // Provenance: SAMPLE listings are demonstration data; LIVE would come from authorized job APIs.
  source          String          @default("SAMPLE")
  externalId      String?
  isSample        Boolean         @default(true)
  isActive        Boolean         @default(true)
  postedAt        DateTime        @default(now())
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  applications Application[]
  savedBy      SavedJob[]

  @@unique([source, externalId])
  @@index([isActive, type])
}

model SavedJob {
  userId    String
  jobId     String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  job       Job      @relation(fields: [jobId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([userId, jobId])
}

model Application {
  id          String            @id @default(cuid())
  userId      String
  user        User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId       String?
  job         Job?              @relation(fields: [jobId], references: [id], onDelete: SetNull)
  company     String
  title       String
  location    String?
  status      ApplicationStatus @default(SAVED)
  appliedAt   DateTime?
  followUpAt  DateTime?
  notes       String?
  url         String?
  createdAt   DateTime          @default(now())
  updatedAt   DateTime          @updatedAt

  @@index([userId, status])
}

model Roadmap {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title      String
  targetRole String
  jobId      String?
  missingSkills String[] @default([])
  content    Json
  createdAt  DateTime @default(now())

  items RoadmapItem[]

  @@index([userId])
}

model RoadmapItem {
  id        String   @id @default(cuid())
  roadmapId String
  roadmap   Roadmap  @relation(fields: [roadmapId], references: [id], onDelete: Cascade)
  order     Int
  skill     String
  title     String
  description String
  resources Json     @default("[]")
  estimatedWeeks Int @default(1)
  completed Boolean  @default(false)
  completedAt DateTime?

  @@index([roadmapId])
}

model InterviewSession {
  id         String          @id @default(cuid())
  userId     String
  user       User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetRole String
  difficulty String          @default("medium")
  status     InterviewStatus @default(IN_PROGRESS)
  summary    Json?
  overallScore Int?
  createdAt  DateTime        @default(now())
  completedAt DateTime?

  questions InterviewQuestion[]

  @@index([userId])
}

model InterviewQuestion {
  id         String   @id @default(cuid())
  sessionId  String
  session    InterviewSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  order      Int
  category   String
  question   String
  answer     String?
  feedback   Json?
  score      Int?
  answeredAt DateTime?

  @@index([sessionId])
}

model ChatMessage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      ChatRole
  content   String
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String?
  entityId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([createdAt])
}
